# YouTube Data API v3 key (public data only - no OAuth, nothing gets posted).
# https://console.cloud.google.com/apis/credentials -> Create credentials -> API key,
# then enable "YouTube Data API v3" for the project.
# Can also be pasted into Settings in the console instead (kept in that browser only).
YOUTUBE_API_KEY=

# Our channel, as an @handle or a UC... channel id. Optional - Settings can set it too.
NEXT_PUBLIC_DEFAULT_CHANNEL=

# Powers the AI desk (/assist). Without it every other page still works.
ANTHROPIC_API_KEY=
